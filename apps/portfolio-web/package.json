{
  "name": "@port/portfolio-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @port/icon-library build:showcase && pnpm --filter @port/design-system build:embed && pnpm --filter @port/dashboard build:embed && tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.7",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@vanilla-extract/css": "^1.20.1",
    "@vercel/analytics": "^2.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@port/dashboard": "workspace:*",
    "@port/design-system": "workspace:*",
    "@port/eslint-config": "workspace:*",
    "@port/icon-library": "workspace:*",
    "@port/typescript-config": "workspace:*",
    "@port/vite-config": "workspace:*",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "eslint": "^10.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
