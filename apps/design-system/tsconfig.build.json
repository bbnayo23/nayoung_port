{
  "extends": "@port/typescript-config/library.json",
  "compilerOptions": {
    "types": [],
    "outDir": "./dist",
    "rootDir": "./src",
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "@/*": ["./src/*"],
      "@dc/*": ["./src/*"],
      "@il/*": ["../icon-library/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["**/*.stories.tsx", "**/*.test.tsx", "src/test/**"]
}
